# Docker build context excludes. NOTE: Docker does NOT read .gitignore — this
# file is the ONLY thing that keeps large/sensitive paths out of the build
# context tar sent to the daemon. Without it, `sandclaude rebuild` streams the
# entire repo (including project/ which holds gigabytes of DinD state AND
# credentials), which is slow and can abort the build with
# "io: read/write on closed pipe".
#
# The Dockerfile only COPYs: allowlist-proxy/, launcher.py, entrypoint.sh,
# proxy-addon.py, .claude/skills/, bin/. Everything else is unnecessary context.

# Local state, credentials, and DinD data — NEVER send to the build (huge + secret)
project/
dind-data/
.docker/
logs/

# Git metadata and worktrees (worktrees are git-ignored too, but .gitignore does
# not affect the Docker context — must be listed here as well)
.git/
.claude/worktrees/

# Prebuilt host binary (the image builds its own proxy; this is the macOS/host
# sandclaude binary and has no place in the Linux image context)
sandclaude

# Encrypted/secret allowlist artifacts and keys
*.enc
*.pem
*.key
.env
.env.*

# Python/editor/OS cruft
__pycache__/
*.pyc
.DS_Store
.vscode/
.idea/

# Databases and logs
*.db
*.db-shm
*.db-wal
*.log

# Node modules (if any project deps leaked into the repo dir)
node_modules/

# Scratch / local dev fixtures
test-apps/
test-server.js
okay-we-are-going-immutable-octopus.md
