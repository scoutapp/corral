<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{.Workspace}} — sandclaude</title>
<link rel="stylesheet" href="/static/dashboard.css">
</head>
<body data-project-id="{{.ID}}">
<header>
  <a href="/" class="back">&larr; All projects</a>
  <h1>{{.Workspace}}</h1>
  <button id="dock-toggle" class="dock-toggle" type="button" title="Show/hide the Claude terminal">⌨ Terminal</button>
  <button id="host-toggle" class="dock-toggle" type="button" title="Show/hide a host shell (⌃`)">▂ Host shell</button>
  <button id="chat-toggle" class="dock-toggle" type="button" title="Ask Claude — a host claude chat (⌃J)">💬 Ask Claude</button>
</header>

<!-- Main work area: the tab set on the left/top, the collapsible Claude terminal
     dock on the right. The dock keeps its own PTY iframe independent of which tab
     is active, so you can view the terminal alongside the editor or collapse it. -->
<div class="project-layout" id="project-layout">
  <div class="tab-area">
    <div class="tabs">
      <button class="tab-btn active" data-tab="files">Files</button>
      <button class="tab-btn" data-tab="diff">Diff</button>
      <button class="tab-btn" data-tab="container">Container</button>
      <button class="tab-btn" data-tab="mitm">Mitm Proxy</button>
      <button class="tab-btn" data-tab="firewall">Firewall Log</button>
      <button class="tab-btn" data-tab="config">Config</button>
    </div>

    <div class="tab-panel" id="tab-files">
      <div id="files-root" class="files-root"><p class="muted">loading files…</p></div>
    </div>

    <div class="tab-panel" id="tab-diff" style="display:none">
      <div id="diff-root" class="diff-root"><p class="muted">loading changes…</p></div>
    </div>

    <div class="tab-panel" id="tab-container" style="display:none">
      {{if .ContainerUp}}
        <div class="screen-frame">
          <div class="screen-bar"><i class="screen-dot"></i>container shell · {{.Workspace}}</div>
          <iframe class="screen-iframe" data-src="/p/{{.ID}}/container/"></iframe>
        </div>
      {{else}}
        <p class="empty">The container isn't running — start it with <code>sandclaude start</code>.</p>
      {{end}}
    </div>

    <div class="tab-panel" id="tab-mitm" style="display:none">
      {{if .MitmUp}}
        <div class="mitm-toolbar">
          <input id="mitm-filter" type="text" placeholder="filter: host, path, method, status…" autocomplete="off" spellcheck="false">
          <span id="mitm-status" class="muted">loading flows…</span>
        </div>
        <div id="mitm-flows"></div>
      {{else}}
        <p class="empty">Credential proxy isn't running for this project.</p>
      {{end}}
    </div>

    <div class="tab-panel" id="tab-firewall" style="display:none">
      <div class="screen-frame">
        <div class="screen-bar"><i class="screen-dot"></i>allowlist proxy · live log</div>
        <pre id="firewall-log" class="screen-body"></pre>
      </div>
    </div>

    <div class="tab-panel" id="tab-config" style="display:none">
      <div id="config-root"><p class="muted">loading config…</p></div>
    </div>
  </div>

  <!-- Detachable Claude terminal dock. Collapsible via #dock-toggle; its iframe
       src is set lazily so no PTY spawns until the dock is first shown. -->
  <aside class="term-dock" id="term-dock">
    {{if .TmuxUp}}
      <div class="screen-frame">
        <div class="screen-bar"><i class="screen-dot"></i>{{.Session}} · Claude</div>
        <iframe class="screen-iframe" id="dock-iframe" data-src="/p/{{.ID}}/terminal/"></iframe>
      </div>
    {{else}}
      <p class="empty">No tmux dev session — start it with <code>sandclaude dev</code>.</p>
    {{end}}
  </aside>
</div>

<!-- Host-terminal overlay: slides up from the bottom (VS Code integrated
     terminal). Hidden until toggled; drag the handle to resize. Its iframe src
     is set lazily on first open so no host shell spawns until you ask for one. -->
<div class="host-overlay" id="host-overlay" hidden>
  <div class="host-overlay-handle" id="host-overlay-handle"></div>
  <div class="host-overlay-bar">
    <span><i class="screen-dot"></i>host shell · {{.Workspace}}</span>
    <button id="host-close" type="button" title="Close (⌃`)">✕</button>
  </div>
  <iframe class="host-overlay-iframe" id="host-iframe" data-src="/p/{{.ID}}/host/"></iframe>
</div>

<!-- "Ask Claude" chat panel — a slide-out that runs the HOST claude (see the
     in-iframe "not sandboxed" warning). Dockable left or right (persisted); the
     iframe src is set lazily on first open so no claude spawns until asked. -->
<div class="chat-panel" id="chat-panel" hidden>
  <div class="chat-panel-handle" id="chat-panel-handle"></div>
  <div class="chat-panel-bar">
    <span><i class="screen-dot"></i>ask claude · host</span>
    <span class="chat-panel-actions">
      <button id="chat-dock" type="button" title="Dock left/right">⇄</button>
      <button id="chat-close" type="button" title="Close (⌃J)">✕</button>
    </span>
  </div>
  <iframe class="chat-panel-iframe" id="chat-iframe" data-src="/p/{{.ID}}/chat/"></iframe>
</div>

<script src="/static/codemirror.bundle.js"></script>
<script src="/static/files.js"></script>
<script src="/static/diff.js"></script>
<script src="/static/mitm.js"></script>
<script src="/static/config.js"></script>
<script src="/static/dashboard.js"></script>
</body>
</html>
