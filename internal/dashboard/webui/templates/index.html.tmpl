<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>sandclaude — control</title>
<link rel="stylesheet" href="/static/dashboard.css">
</head>
<body class="console">
<div class="app-shell">
  <!-- Left sidebar navigation -->
  <nav class="sidebar">
    <div class="brand">
      <span class="brand-mark">◇</span>
      <span class="brand-name">sandclaude</span>
    </div>
    <button type="button" class="nav-item active" data-section="projects">
      <span class="nav-ico">▤</span> Projects
    </button>
    <button type="button" class="nav-item" data-section="repos">
      <span class="nav-ico">◧</span> Repos
    </button>
    <div class="sidebar-spacer"></div>
    <button id="new-project" type="button" class="sidebar-cta" title="Create a new project">+ New project</button>
    <a href="/global" class="nav-item nav-link">⚙ Global settings</a>
  </nav>

  <!-- Main content: one section visible at a time -->
  <div class="content">
    <header class="content-head">
      <h1 id="section-title">Projects</h1>
      <div class="head-right">
        <div class="legend" id="legend">
          <span class="legend-item"><i class="dot working"></i>working</span>
          <span class="legend-item"><i class="dot waiting"></i>waiting</span>
          <span class="legend-item"><i class="dot off"></i>idle</span>
        </div>
        <button id="mute-all" type="button" class="btn mute-all" aria-pressed="false" title="Mute all alerts">🔔 alerts</button>
      </div>
    </header>

    <!-- Projects section -->
    <section class="section active" id="section-projects">
      <main id="panes" class="panes">
        {{if not .Projects}}
        <p class="empty" id="no-projects">No projects yet. Click <strong>+ New project</strong> to start one from a repo, several repos, or a blank directory.</p>
        {{end}}
      </main>
    </section>

    <!-- Repos section -->
    <section class="section" id="section-repos" hidden>
      <div class="section-toolbar">
        <button id="add-repo" type="button" class="btn primary" title="Add a repository">+ Add repo</button>
      </div>
      <div class="repos-list" id="repos-list"><p class="muted">loading repos…</p></div>
    </section>
  </div>
</div>

<footer class="console-footer">
  <span id="summary" class="muted">connecting…</span>
</footer>

<!-- New-project / add-repo modal (hidden until opened). -->
<div class="modal-backdrop" id="modal" hidden>
  <div class="modal" role="dialog" aria-modal="true">
    <div class="modal-head"><span id="modal-title">New project</span>
      <button id="modal-close" type="button" title="Close">✕</button></div>
    <div class="modal-body" id="modal-body"></div>
  </div>
</div>

<!-- xterm + shared SSH-load modal so Start can load a keyed project's SSH keys
     inline (passphrase in a real PTY) without leaving the landing page. -->
<script src="/static/xterm.js"></script>
<script src="/static/xterm-addon-fit.js"></script>
<script src="/static/ssh-load.js"></script>
<script src="/static/panes.js"></script>
<script src="/static/projects-ui.js"></script>
</body>
</html>
