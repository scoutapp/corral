<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>host terminal</title>
<link rel="stylesheet" href="/static/xterm.css">
<style>
  html, body { margin: 0; height: 100%; background: #1e1e1e; }
  #term { position: absolute; inset: 0; padding: 4px; }
</style>
</head>
<!-- Host shell: always available (loopback + token gated). data-session-up=true
     so the shared terminal.js client connects; data-ws-path targets /host/ws. -->
<body data-id="{{.ID}}" data-session-up="true" data-ws-path="/host/ws">
  <div id="term"></div>
  <script src="/static/xterm.js"></script>
  <script src="/static/xterm-addon-fit.js"></script>
  <script src="/static/terminal.js"></script>
</body>
</html>
