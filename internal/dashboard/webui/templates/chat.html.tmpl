<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>ask claude</title>
<style>
  /* Claude-Desktop-inspired chat surface: warm cream ground, clay accent,
     rounded bubbles, sticky composer. Deliberately NOT the dashboard's dark
     console theme — the different look signals this is a distinct (host,
     not-sandboxed) chat, not the sandboxed Claude terminal. */
  :root {
    --cream: #F5F4EE;
    --cream-hi: #FBFAF7;
    --clay: #C15F3C;         /* Claude signature clay/coral */
    --clay-soft: #E8D9CE;
    --ink: #2B2A27;
    --muted: #706C64;
    --line: #E3E0D8;
    --user-bubble: #ECE7DE;
    --warn-bg: #FBEEE6;
    --warn-line: #E7C7B4;
    --warn-ink: #8A4B2C;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  body {
    display: flex; flex-direction: column; height: 100%;
    background: var(--cream); color: var(--ink);
    font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif;
  }
  /* Not-sandboxed notice — kept from the terminal version, restyled to the theme. */
  #not-sandboxed {
    flex: 0 0 auto; background: var(--warn-bg); color: var(--warn-ink);
    border-bottom: 1px solid var(--warn-line);
    font-size: 12px; padding: 7px 14px;
  }
  #not-sandboxed strong { color: var(--clay); }

  #log { flex: 1 1 auto; overflow-y: auto; padding: 18px 16px 8px; }
  .msg { max-width: 760px; margin: 0 auto 18px; display: flex; gap: 10px; }
  .msg .avatar {
    flex: 0 0 26px; width: 26px; height: 26px; border-radius: 6px;
    display: grid; place-items: center; font-size: 14px; margin-top: 1px;
  }
  .msg.assistant .avatar { background: var(--clay); color: #fff; }
  .msg.user { flex-direction: row-reverse; }
  .msg.user .bubble {
    background: var(--user-bubble); border-radius: 14px 14px 4px 14px;
    padding: 9px 13px;
  }
  .msg.user .avatar { background: var(--clay-soft); color: var(--clay); }
  .bubble { min-width: 0; }
  .bubble p { margin: 0 0 8px; }
  .bubble p:last-child { margin-bottom: 0; }
  .bubble pre {
    background: #2B2A27; color: #F5F4EE; border-radius: 10px;
    padding: 12px 14px; overflow-x: auto; font-size: 12.5px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .bubble code:not(pre code) {
    background: #EBE7DE; border-radius: 4px; padding: 1px 5px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.9em;
  }
  .tool-chip {
    display: inline-block; font-size: 11.5px; color: var(--muted);
    background: var(--cream-hi); border: 1px solid var(--line);
    border-radius: 999px; padding: 2px 9px; margin: 2px 0;
  }
  .tool-chip::before { content: "🔧 "; }
  .meta { max-width: 760px; margin: -8px auto 18px; color: var(--muted); font-size: 11.5px; padding-left: 36px; }
  .meta.error { color: #B23; }
  .typing { color: var(--muted); font-style: italic; }

  /* Composer */
  #composer {
    flex: 0 0 auto; border-top: 1px solid var(--line); background: var(--cream-hi);
    padding: 10px 16px 14px;
  }
  .composer-inner { max-width: 760px; margin: 0 auto; display: flex; gap: 8px; align-items: flex-end;
    background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 8px 8px 8px 14px; }
  #input {
    flex: 1 1 auto; border: none; outline: none; resize: none; background: transparent;
    font: inherit; color: var(--ink); max-height: 160px; line-height: 1.5;
  }
  #send {
    flex: 0 0 auto; width: 34px; height: 34px; border: none; border-radius: 10px;
    background: var(--clay); color: #fff; font-size: 16px; cursor: pointer;
  }
  #send:disabled { opacity: 0.4; cursor: default; }
  .hint { max-width: 760px; margin: 6px auto 0; color: var(--muted); font-size: 11px; text-align: center; }
</style>
</head>
<body data-id="{{.ID}}">
  <div id="not-sandboxed">
    ⚠️ <strong>Not sandboxed.</strong> Runs Claude on your host with your own
    credentials — not in the container. Tools are read-only by default.
  </div>
  <div id="log"></div>
  <div id="composer">
    <div class="composer-inner">
      <textarea id="input" rows="1" placeholder="Ask Claude about this project…" autofocus></textarea>
      <button id="send" type="button" title="Send (Enter)">↑</button>
    </div>
    <div class="hint">Enter to send · Shift+Enter for newline · host claude in this workspace</div>
  </div>
  <script src="/static/chat.js"></script>
</body>
</html>
