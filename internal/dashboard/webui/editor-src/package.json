{
  "name": "sandclaude-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Self-contained CodeMirror 6 bundle for the sandclaude dashboard (no-build vanilla frontend).",
  "scripts": {
    "build": "esbuild editor.js --bundle --format=iife --global-name=SandclaudeEditor --minify --outfile=../static/codemirror.bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/merge": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "codemirror": "^6.0.1"
  }
}
