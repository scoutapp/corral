#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
IMAGE_NAME="sandclaude"
CONFIG_DIR="$HOME/.config/sandclaude"
PROJECTS_DIR="$CONFIG_DIR/projects"

# Ensure config directory exists
mkdir -p "$CONFIG_DIR" "$PROJECTS_DIR"

usage() {
    cat <<EOF
sandclaude - Sandboxed Claude Code with network firewall

Usage: sandclaude <command> [options]

Commands:
  init [project]           Initialize a new project with credentials
  start [project]          Start Claude Code for a project (default: current directory)
  copy <target>            Copy sandclaude files to target directory
  list                     List configured projects
  shell [project]          Open bash shell in container
  rebuild [project]        Force rebuild container image
  help                     Show this help

Examples:
  sandclaude init myapp              # Setup new project with credentials
  sandclaude start myapp             # Start Claude for 'myapp' project
  sandclaude start                   # Start with current directory name as project
  sandclaude copy ~/my-project       # Copy files to integrate into another project
  sandclaude shell myapp             # Debug container for 'myapp'

Environment:
  Projects are stored in: $PROJECTS_DIR
  Each project has its own credentials and configuration

EOF
}

# Get project name from argument or current directory
get_project_name() {
    if [ -n "${1:-}" ]; then
        echo "$1"
    else
        basename "$(pwd)"
    fi
}

# Get project directory
get_project_dir() {
    local project="$1"
    echo "$PROJECTS_DIR/$project"
}

# Initialize a new project
cmd_init() {
    local project="${1:-}"

    if [ -z "$project" ]; then
        read -r -p "Project name: " project
        if [ -z "$project" ]; then
            echo "Error: Project name required"
            exit 1
        fi
    fi

    local project_dir
    project_dir="$(get_project_dir "$project")"

    if [ -d "$project_dir" ]; then
        echo "Error: Project '$project' already exists at $project_dir"
        exit 1
    fi

    echo "Initializing project: $project"
    echo ""

    # Create project structure
    mkdir -p "$project_dir"/{credentials,config}

    # Ask for repository (optional)
    echo ""
    read -r -p "Enable GitHub issue monitoring? [y/N]: " enable_github
    if [[ "$enable_github" =~ ^[Yy]$ ]]; then
        read -r -p "GitHub repository (e.g. owner/repo): " repo
        if [ -n "$repo" ]; then
            echo "$repo" > "$project_dir/config/repo"
            echo "✅ GitHub monitoring enabled for $repo"
        else
            echo "⚠️  No repo provided. GitHub monitoring disabled."
        fi
    else
        echo "⚠️  GitHub monitoring disabled"
    fi

    # Ask for AWS credentials (optional)
    echo ""
    read -r -p "Mount AWS credentials? [y/N]: " enable_aws
    if [[ "$enable_aws" =~ ^[Yy]$ ]]; then
        echo "enabled" > "$project_dir/config/aws_enabled"
        echo "✅ AWS credentials will be mounted from ~/.aws"
    else
        echo "⚠️  AWS credentials will not be mounted"
    fi

    # Ask for proxy usage (optional)
    echo ""
    read -r -p "Enable credential proxy (hides secrets from Claude)? [y/N]: " enable_proxy
    if [[ "$enable_proxy" =~ ^[Yy]$ ]]; then
        echo "enabled" > "$project_dir/config/proxy_enabled"
        echo "✅ Proxy mode enabled - Claude will use dummy credentials"
        echo "   Configure real credentials in ~/.config/sandclaude/proxy-credentials.json"
    else
        echo "⚠️  Proxy mode disabled"
    fi

    # Ask for workspace directory (default to parent of current directory)
    echo ""
    local default_workspace
    default_workspace="$(cd "$(dirname "$(pwd)")" && pwd)"
    read -r -p "Workspace directory (default: $default_workspace): " workspace
    workspace="${workspace:-$default_workspace}"
    echo "$workspace" > "$project_dir/config/workspace"

    # Create workspace if it doesn't exist
    if [ ! -d "$workspace" ]; then
        read -r -p "Workspace doesn't exist. Create it? [y/N]: " create_workspace
        if [[ "$create_workspace" =~ ^[Yy]$ ]]; then
            mkdir -p "$workspace"
            echo "Created workspace: $workspace"
        fi
    fi

    # Save metadata
    cat > "$project_dir/config/metadata.json" <<EOF
{
  "project": "$project",
  "created": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "workspace": "$workspace"
}
EOF

    echo ""
    echo "✅ Project '$project' initialized at $project_dir"
    echo ""
    echo "Credentials stored securely in: $project_dir/credentials/"
    echo "Configuration: $project_dir/config/"
    echo ""
    echo "Next steps:"
    echo "  sandclaude start $project    # Start Claude Code"
    echo ""
}

# Copy files to target directory
cmd_copy() {
    local target="${1:-}"

    if [ -z "$target" ]; then
        echo "Error: Target directory required"
        echo "Usage: sandclaude copy <target>"
        exit 1
    fi

    # Normalize target path
    target="${target%/}"  # Remove trailing slash if present

    # If target ends with .devcontainer, use it as-is
    # Otherwise append .devcontainer
    if [[ ! "$target" =~ \.devcontainer$ ]]; then
        target="$target/.devcontainer"
    fi

    # Create target directory
    mkdir -p "$target"
    target="$(cd "$target" && pwd)"

    echo "Copying sandclaude files to: $target"
    echo ""

    # Copy core files to .devcontainer
    cp "$SCRIPT_DIR/Dockerfile" "$target/"
    cp "$SCRIPT_DIR/entrypoint.sh" "$target/"
    cp "$SCRIPT_DIR/init-firewall.sh" "$target/"
    cp "$SCRIPT_DIR/firewall-helper.sh" "$target/"
    cp "$SCRIPT_DIR/launcher.py" "$target/"
    cp "$SCRIPT_DIR/proxy-addon.py" "$target/"
    cp "$SCRIPT_DIR/start-proxy.sh" "$target/"

    # Copy devcontainer.json
    cp "$SCRIPT_DIR/devcontainer.template.json" "$target/devcontainer.json"

    # Copy skill
    mkdir -p "$target/skill"
    cp "$SCRIPT_DIR/skill/SKILL.md" "$target/skill/"

    # Copy gitignore to parent directory if it doesn't exist
    local parent_dir="$(dirname "$target")"
    if [ ! -f "$parent_dir/.gitignore" ]; then
        cp "$SCRIPT_DIR/.gitignore" "$parent_dir/"
    fi

    echo "✅ Files copied to $target"
    echo ""
    echo "Next steps:"
    echo "  1. Customize $target/Dockerfile if needed"
    echo "  2. Add domains to $target/init-firewall.sh"
    echo "  3. Open in VS Code: code $(dirname "$target")"
    echo "  4. Click 'Reopen in Container'"
    echo ""
}

# List projects
cmd_list() {
    if [ ! -d "$PROJECTS_DIR" ] || [ -z "$(ls -A "$PROJECTS_DIR" 2>/dev/null)" ]; then
        echo "No projects configured"
        echo "Run: sandclaude init <project>"
        return
    fi

    echo "Configured projects:"
    echo ""

    for project_dir in "$PROJECTS_DIR"/*; do
        if [ -d "$project_dir" ]; then
            local project
            project="$(basename "$project_dir")"
            local workspace=""

            if [ -f "$project_dir/config/workspace" ]; then
                workspace="$(cat "$project_dir/config/workspace")"
            fi

            echo "  $project"
            if [ -n "$workspace" ]; then
                echo "    Workspace: $workspace"
            fi
            if [ -f "$project_dir/config/repo" ]; then
                echo "    GitHub: $(cat "$project_dir/config/repo")"
            fi
            if [ -f "$project_dir/config/aws_enabled" ]; then
                echo "    AWS: enabled"
            fi
            echo ""
        fi
    done
}

# Build Docker image
build_image() {
    if [ ! -f "$SCRIPT_DIR/Dockerfile" ]; then
        echo "Error: No Dockerfile found in $SCRIPT_DIR"
        exit 1
    fi
    echo "Building $IMAGE_NAME image..."
    docker build \
        --build-arg USER_ID="$(id -u)" \
        --build-arg GROUP_ID="$(id -g)" \
        -t "$IMAGE_NAME" \
        "$SCRIPT_DIR"
}

# Start Claude Code
cmd_start() {
    local project
    project="$(get_project_name "${1:-}")"

    local project_dir
    project_dir="$(get_project_dir "$project")"

    # Check if project exists
    if [ ! -d "$project_dir" ]; then
        echo "Error: Project '$project' not found"
        echo "Run: sandclaude init $project"
        exit 1
    fi

    # Get workspace
    local workspace
    if [ -f "$project_dir/config/workspace" ]; then
        workspace="$(cat "$project_dir/config/workspace")"
    else
        echo "Error: No workspace configured for project '$project'"
        exit 1
    fi

    if [ ! -d "$workspace" ]; then
        echo "Error: Workspace not found: $workspace"
        exit 1
    fi

    # Check Claude credentials
    local claude_config="$HOME/.claude"
    if [ ! -f "$claude_config/.credentials.json" ]; then
        echo "Error: No Claude credentials found at $claude_config/.credentials.json"
        echo "Run 'claude' locally first to log in via OAuth."
        exit 1
    fi

    # Build image if needed
    if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
        build_image
    fi

    clear
    echo "🚀 Starting sandclaude for project: $project"
    echo "📁 Workspace: $workspace"
    echo ""

    # Extract gh token if available
    local gh_token
    gh_token="$(gh auth token 2>/dev/null || true)"

    # Build Docker args
    local docker_args=(
        --rm -it
        --cap-add=NET_ADMIN
        --cap-add=NET_RAW
        -v "$claude_config:/home/claude/.claude"
        -v "$HOME/.claude.json:/home/claude/.claude.json"
        -v "$HOME/.config/gh:/home/claude/.config/gh:ro"
        ${gh_token:+-e GH_TOKEN="$gh_token"}
        -v "$workspace:$workspace"
        -w "$workspace"
        -e PROJECT_NAME="$project"
    )

    # Mount GitHub repo configuration
    if [ -f "$project_dir/config/repo" ]; then
        docker_args+=(-e GITHUB_REPO="$(cat "$project_dir/config/repo")")
    fi

    # Mount AWS credentials if enabled
    if [ -f "$project_dir/config/aws_enabled" ]; then
        if [ -d "$HOME/.aws" ]; then
            docker_args+=(-v "$HOME/.aws:/home/claude/.aws:ro")
            docker_args+=(-e AWS_SHARED_CREDENTIALS_FILE="/home/claude/.aws/credentials")
            docker_args+=(-e AWS_CONFIG_FILE="/home/claude/.aws/config")
        else
            echo "Warning: AWS credentials requested but ~/.aws not found"
        fi
    fi

    # Mount skill if it exists
    local skill_path="$SCRIPT_DIR/skill/SKILL.md"
    if [ -f "$skill_path" ]; then
        docker_args+=(-v "$skill_path:/home/claude/.claude/skills/sandclaude.md:ro")
    fi

    # Enable proxy if configured
    if [ -f "$project_dir/config/proxy_enabled" ]; then
        docker_args+=(-e HTTP_PROXY="http://host.docker.internal:8080")
        docker_args+=(-e HTTPS_PROXY="http://host.docker.internal:8080")
        echo "🔒 Proxy mode enabled - run 'bash start-proxy.sh' on host first"
    fi

    exec docker run "${docker_args[@]}" "$IMAGE_NAME"
}

# Open shell
cmd_shell() {
    local project
    project="$(get_project_name "${1:-}")"

    local project_dir
    project_dir="$(get_project_dir "$project")"

    if [ ! -d "$project_dir" ]; then
        echo "Error: Project '$project' not found"
        exit 1
    fi

    local workspace
    if [ -f "$project_dir/config/workspace" ]; then
        workspace="$(cat "$project_dir/config/workspace")"
    else
        workspace="$(pwd)"
    fi

    # Build image if needed
    if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
        build_image
    fi

    local claude_config="$HOME/.claude"
    local gh_token
    gh_token="$(gh auth token 2>/dev/null || true)"

    exec docker run \
        --rm -it \
        --cap-add=NET_ADMIN \
        --cap-add=NET_RAW \
        -v "$claude_config:/home/claude/.claude" \
        -v "$workspace:$workspace" \
        -w "$workspace" \
        ${gh_token:+-e GH_TOKEN="$gh_token"} \
        --entrypoint /bin/bash \
        "$IMAGE_NAME"
}

# Rebuild image
cmd_rebuild() {
    build_image
}

# Main command dispatcher
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    init)
        cmd_init "$@"
        ;;
    start)
        cmd_start "$@"
        ;;
    copy)
        cmd_copy "$@"
        ;;
    list)
        cmd_list "$@"
        ;;
    shell)
        cmd_shell "$@"
        ;;
    rebuild)
        cmd_rebuild "$@"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Error: Unknown command '$COMMAND'"
        echo ""
        usage
        exit 1
        ;;
esac
