# Credentials and secrets - NEVER commit these
.credentials.json
*.pem
*.key
*.env
.env.*
secrets/
credentials/

# test apps used in dev
test-apps/

# Don't believe we want these in version control
.claude/worktrees

# Generated files - do not commit
.devcontainer

# Is generated by sandclaude init using the .allowlist-key
allowlist-proxy/allowed-domains.txt.enc

# Project directory — never commit (contains credentials and local config)
project/

# Per-project sandclaude state (config, allowlist, key, logs) — never commit
.sandclaude/

__pycache__/

# Docker volumes and state
.docker/

# Scratch planning docs — not part of the shipped project
plans/

# Legacy firewall directory (replaced by allowlist-proxy/allowed-domains.txt.enc)
.firewall/

# Encrypted allowlist (generated from allowed-domains.txt + .key)
allowlist-proxy/allowed-domains.txt.enc

# Log directory
logs/

# OS and editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
dist/
build/
*.log
node_modules/

# The compiled host binary at the repo root ONLY. Anchored with a leading slash
# so it does NOT also match the cmd/sandclaude/ source dir (an unanchored
# `sandclaude` rule silently ignored the entrypoint package).
/sandclaude
# local dev builds of the CLI (e.g. `go build -o sandclaude-dev`)
/sandclaude-dev
# SQLite database files
*.db
*.db-shm
*.db-wal
