# Credentials and secrets - NEVER commit these
.credentials.json
*.pem
*.key
*.env
.env.*
secrets/
credentials/

# test apps used in dev
test-apps/

# Don't believe we want these in version control
.claude/worktrees

# Generated files - do not commit
.devcontainer

# Is generated by corral init using the .allowlist-key
allowlist-proxy/allowed-domains.txt.enc

# Per-project corral state — never commit (contains credentials + local
# config). Anchored so it does NOT also swallow source dirs like
# internal/project/ (a bare `project/` matched those too). Covers both the
# current .corral/project/ location and a legacy root-level project/ dir.
.corral/project/
/project/

# Per-project corral state (config, allowlist, key, logs) — never commit
.corral/
# Legacy pre-rename state dir (was sandclaude); ignore so leftovers aren't committed
.sandclaude/

__pycache__/

# Docker volumes and state
.docker/

# Scratch planning docs — not part of the shipped project
plans/

# Legacy firewall directory (replaced by allowlist-proxy/allowed-domains.txt.enc)
.firewall/

# Encrypted allowlist (generated from allowed-domains.txt + .key)
allowlist-proxy/allowed-domains.txt.enc

# Log directory
logs/

# OS and editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
dist/
build/
*.log
node_modules/

# The compiled host binary at the repo root ONLY. Anchored with a leading slash
# so it does NOT also match the cmd/corral/ source dir (an unanchored
# `corral` rule silently ignored the entrypoint package).
/corral
# local dev builds of the CLI (e.g. `go build -o corral-dev`)
/corral-dev
# SQLite database files
*.db
*.db-shm
*.db-wal

# local scratch (workflow scripts, throwaway drivers) — never commit
scratchpad/
