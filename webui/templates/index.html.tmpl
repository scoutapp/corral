<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>sandclaude dashboard</title>
<link rel="stylesheet" href="/static/dashboard.css">
</head>
<body>
<header>
  <h1>sandclaude dashboard</h1>
</header>

{{if not .Projects}}
  <p class="empty">No projects registered yet. Run <code>sandclaude start</code> or <code>sandclaude dev</code> in a project directory, then reload this page.</p>
{{else}}
  <table class="projects">
    <thead>
      <tr><th>Workspace</th><th>Container</th><th>Terminal</th><th>Mitm Proxy</th></tr>
    </thead>
    <tbody>
      {{range .Projects}}
      <tr>
        <td><a href="/p/{{.ID}}">{{.Workspace}}</a></td>
        <td>{{if .ContainerUp}}<span class="badge up">running</span>{{else}}<span class="badge down">stopped</span>{{end}}</td>
        <td>{{if .TmuxUp}}<span class="badge up">available</span>{{else}}<span class="badge down">—</span>{{end}}</td>
        <td>{{if .MitmUp}}<span class="badge up">running</span>{{else}}<span class="badge down">—</span>{{end}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
{{end}}
</body>
</html>
