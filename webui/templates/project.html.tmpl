<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{.Workspace}} — sandclaude</title>
<link rel="stylesheet" href="/static/dashboard.css">
</head>
<body data-project-id="{{.ID}}">
<header>
  <a href="/" class="back">&larr; All projects</a>
  <h1>{{.Workspace}}</h1>
</header>

<div class="tabs">
  <button class="tab-btn active" data-tab="terminal">Terminal</button>
  <button class="tab-btn" data-tab="mitm">Mitm Proxy</button>
  <button class="tab-btn" data-tab="firewall">Firewall Log</button>
</div>

<div class="tab-panel" id="tab-terminal">
  {{if .TmuxUp}}
    <iframe class="tab-iframe" data-src="/p/{{.ID}}/terminal/"></iframe>
  {{else}}
    <p class="empty">No tmux dev session for this project — start it with <code>sandclaude dev</code>.</p>
  {{end}}
</div>

<div class="tab-panel" id="tab-mitm" style="display:none">
  {{if .MitmUp}}
    {{/* mitmweb is a single-page app rooted at "/" with absolute asset paths and
         no base-path option, and it refuses non-IP Host headers (DNS-rebinding
         guard), so it can't be reverse-proxied under a subpath. Link straight to
         its own origin instead — the robust option. */}}
    <p class="mitm-link">
      Credential proxy is running.
      <a href="http://127.0.0.1:{{.MitmWebPort}}/" target="_blank" rel="noopener">Open mitmweb &#8599;</a>
    </p>
  {{else}}
    <p class="empty">Credential proxy isn't running for this project.</p>
  {{end}}
</div>

<div class="tab-panel" id="tab-firewall" style="display:none">
  <pre id="firewall-log"></pre>
</div>

<script src="/static/dashboard.js"></script>
</body>
</html>
