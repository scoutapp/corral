{
  "name": "Sandclaude with Firewall",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".devcontainer",
    "args": {
      "USER_ID": "${localEnv:UID:1000}",
      "GROUP_ID": "${localEnv:GID:1000}"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "claude",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
    "source=${localWorkspaceFolder}/.devcontainer/skill/SKILL.md,target=/home/claude/.claude/skills/sandclaude.md,type=bind,readonly"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/claude/.claude"
  },
  "workspaceFolder": "/workspace",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
